{
  "name": "loom-cli",
  "version": "0.1.0",
  "description": "AI workflow pipeline manager and intelligent terminal agent",
  "type": "module",
  "bin": {
    "loom": "./dist/loom"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/loom",
    "build:linux": "bun build src/index.ts --compile --target bun-linux-x64 --outfile dist/loom-linux-x64",
    "build:mac": "bun build src/index.ts --compile --target bun-darwin-arm64 --outfile dist/loom-darwin-arm64",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "ai": "^3.3.0",
    "@ai-sdk/openai": "^0.0.53",
    "@ai-sdk/anthropic": "^0.0.48",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "commander": "^12.1.0",
    "zod": "^3.23.8",
    "yaml": "^2.4.5",
    "chalk": "^5.3.0",
    "glob": "^11.0.0",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/ms": "^0.7.34",
    "@biomejs/biome": "^1.8.3",
    "typescript": "^5.5.3",
    "@types/bun": "latest"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
