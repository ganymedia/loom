{
  "name": "loom",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "loom": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build --compile ./src/index.ts --outfile ./dist/loom",
    "build:linux": "bun run build:linux:x64 && bun run build:linux:arm64",
    "build:linux:x64": "bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile ./dist/loom-linux-x64",
    "build:linux:arm64": "bun build --compile --target=bun-linux-arm64 ./src/index.ts --outfile ./dist/loom-linux-arm64",
    "build:mac": "bun run build:mac:x64 && bun run build:mac:arm64",
    "build:mac:x64": "bun build --compile --target=bun-darwin-x64 ./src/index.ts --outfile ./dist/loom-darwin-x64",
    "build:mac:arm64": "bun build --compile --target=bun-darwin-arm64 ./src/index.ts --outfile ./dist/loom-darwin-arm64",
    "release": "sh scripts/release.sh",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.12",
    "@types/react": "^19.2.17",
    "typescript": "^5.6.3"
  }
}
